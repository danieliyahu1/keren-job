{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/longcat-2.5-free",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chromium", "--user-data-dir", "/home/opencode/.playwright-mcp", "--output-dir", "/home/opencode/.playwright-mcp-output"]
      }
    }
  }
}
